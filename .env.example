# .env.example — install.sh writes the real .env, never commit it
YIELDO_PORT=8080
YIELDO_SECRET_KEY=
YIELDO_REGISTRATION_OPEN=true
YIELDO_ACCESS_TOKEN_MINUTES=30
YIELDO_REFRESH_TOKEN_DAYS=30
# Secondes accordées au modèle de langage optionnel pour répondre. C'est le
# DÉFAUT : un foyer dont le modèle local raisonne longtemps relève son propre
# plafond dans Réglages → Connexions, sans toucher à ce fichier ni redémarrer.
YIELDO_LLM_TIMEOUT_SECONDS=120
YIELDO_CONTAINER_NAME=yieldo
